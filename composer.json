{
    "name": "nirmal/advanced-role-right",
    "description": "An enterprise-grade advanced role and permission system for Laravel with audit trails, temporary roles, and a premium management UI.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nirmal Modi",
            "email": "nirmal@example.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/auth": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Nirmal\\RoleRight\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nirmal\\RoleRight\\AdvancedRoleRightServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
